{
  "name": "trx-energy-telegram-bot",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "vitest run tests/postgres-integration.test.ts && vitest run tests/postgres-energy-consumption-integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "check": "npm run typecheck && npm run build && npm test",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/runtime/start.js",
    "db:migrate": "node dist/runtime/migrate.js",
    "db:bootstrap": "node dist/runtime/bootstrap-catalog.js",
    "db:prepare": "npm run db:migrate && npm run db:bootstrap"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "grammy": "1.45.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
