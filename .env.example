# Public template only. Never commit production values.
NODE_ENV=development

# Secret provider
# "environment" reads application secrets from the deployment environment.
# "infisical" fetches application secrets from Infisical using Machine Identity Universal Auth.
# DATABASE_URL is always an infrastructure secret supplied by the deployment environment.
SECRET_PROVIDER=environment

# Infisical bootstrap configuration
# Keep INFISICAL_CLIENT_SECRET in a write-only/sealed deployment variable.
# Application secrets such as BOT_TOKEN and TRON_API_KEY stay in Infisical.
INFISICAL_SITE_URL=https://app.infisical.com
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=
INFISICAL_SECRET_PATH=/
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# Telegram
BOT_TOKEN=
SUPER_ADMIN_ID=

# PostgreSQL infrastructure secret
# Keep this in the deployment environment; seal it in production.
DATABASE_URL=

# TRON API credential
# Required when NODE_ENV=production and USDT payment runtime is enabled.
TRON_API_KEY=

# USDT payment runtime
# Leave every USDT_* key below unset to keep payment runtime disabled.
# If any key is configured, all required keys must be configured.
USDT_PAYMENT_ADDRESS=
USDT_TOKEN_CONTRACT_ADDRESS=
USDT_REQUIRED_CONFIRMATIONS=
USDT_ATTRIBUTION_MAX_OFFSET_MICROS=
USDT_QUOTE_TTL_MS=

# TRON read endpoints and reconciliation worker
USDT_TRON_GRID_BASE_URL=
USDT_TRON_HEAD_BASE_URL=
USDT_TRON_SOLIDIFIED_BASE_URL=
USDT_TRON_HTTP_TIMEOUT_MS=
USDT_SCAN_INTERVAL_MS=
USDT_SCAN_MAX_ORDERS=
USDT_SCAN_MAX_PAGES=
USDT_TRON_GRID_PAGE_SIZE=

# Energy runtime (ordinary bot service)
# Leave every ENERGY_* key below unset to keep Energy writes disabled.
# If any key is configured, all required Energy keys must be configured.
# The bot service may receive TRON_SIGNER_AUTH_TOKEN, but it must never receive
# TRON_SIGNER_PRIVATE_KEY.
ENERGY_PROVIDER=
ENERGY_OWNER_ADDRESS=
ENERGY_TRON_HEAD_BASE_URL=
ENERGY_TRON_SOLIDIFIED_BASE_URL=
ENERGY_TRON_HTTP_TIMEOUT_MS=
ENERGY_SIGNER_BASE_URL=
ENERGY_SIGNER_HTTP_TIMEOUT_MS=
TRON_SIGNER_AUTH_TOKEN=

# Dedicated signer service
# Deploy the signer from the same audited repository branch as the bot and set:
# TRX_RUNTIME_ROLE=signer
# Keep the signer private key only in the signer service's SecretProvider scope.
TRX_RUNTIME_ROLE=
TRON_SIGNER_OWNER_ADDRESS=
PORT=

# Signer-owned secrets (names only; never commit production values)
TRON_SIGNER_PRIVATE_KEY=
# TRON_SIGNER_AUTH_TOKEN is shared only as the authenticated transport token
# between the bot and signer runtimes. Use separate secret scopes/identities.

